# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files and secrets
.env*
!.env.example

# Local package-manager snapshots retained only for workspace recovery
package.before.json
package-lock.before.json

# Supabase CLI local state
/supabase/.temp/
.supabase/

# Editor and OS noise
.idea/
.vscode/
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
