# Supabase project values; safe to commit because this file contains placeholders only.
# Public values are inlined into the browser bundle at build time. Set them for
# both the image build and the Cloud Run runtime, or the browser client will fail.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable (or anon) key. Never use a service-role or sb_secret_ key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
